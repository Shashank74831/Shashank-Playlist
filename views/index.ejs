<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= appName %> | Home</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <nav class="navbar">
        <a class="logo" href="/">❤️ <%= appName %></a>

        <div class="nav-links">
            <a href="/">Home</a>
            <a href="/songs">Songs</a>
        </div>
    </nav>

    <main class="home-page">

        <section class="hero-section">

            <div class="hero-content">

                <div class="heart-animation">♡</div>

                <p class="hero-eyebrow">HIS VIBE. HIS MUSIC. HIS PLAYLIST.</p>

                <h1>
                    Welcome to
                    <span><%= appName %></span>
                </h1>

                <p class="hero-description">
                    Every beat has a feeling.
                    Every melody has a memory.
                    Explore a collection of songs
                    that brings music and moments together.
                </p>

                <a href="/songs" class="explore-btn">
                    Explore the Playlist <span>→</span>
                </a>

                <div class="hero-footer">
                    MADE WITH LOVE · CURATED WITH MEANING
                </div>

            </div>

        </section>

    </main>

    <footer>
        <p>Made with ❤️ | © 2026 <%= appName %></p>
    </footer>

</body>
</html>